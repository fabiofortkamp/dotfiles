#!/usr/bin/env bash

set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
GHOSTTY_CONFIG_DIR="${GHOSTTY_CONFIG_DIR:-$CONFIG_HOME/ghostty}"
CONFIG_FILE="${GHOSTTY_THEME_CONTEXT_FILE:-$GHOSTTY_CONFIG_DIR/theme-context.toml}"
OVERRIDE_FILE="${GHOSTTY_THEME_AUTO_FILE:-$GHOSTTY_CONFIG_DIR/theme-auto.conf}"
CACHE_FILE="${GHOSTTY_THEME_CACHE_FILE:-$STATE_HOME/ghostty-theme-context/current-theme}"

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

normalize_path() {
  local path="$1"

  path="${path/#\~/$HOME}"

  if [[ "$path" != "/" ]]; then
    while [[ "$path" == */ ]]; do
      path="${path%/}"
    done
  fi

  printf '%s\n' "$path"
}

path_matches_prefix() {
  local dir="$1"
  local prefix="$2"

  # Match the configured directory itself and any child directory below it,
  # without letting `/foo` also match `/foobar`.
  case "$dir" in
    "$prefix" | "$prefix"/*) return 0 ;;
    *) return 1 ;;
  esac
}

load_theme_for_dir() {
  local target_dir
  target_dir="$(normalize_path "$1")"

  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "missing config: $CONFIG_FILE" >&2
    return 1
  fi

  local line trimmed key value
  local default_theme=""
  local current_path_prefix=""
  local current_theme=""
  local matched_theme=""

  maybe_match_rule() {
    if [[ -n "$current_path_prefix" && -n "$current_theme" ]] \
      && path_matches_prefix "$target_dir" "$current_path_prefix"; then
      matched_theme="$current_theme"
    fi
  }

  while IFS= read -r line || [[ -n "$line" ]]; do
    trimmed="$(trim "$line")"

    if [[ -z "$trimmed" || "$trimmed" == \#* ]]; then
      continue
    fi

    if [[ "$trimmed" == "[[rules]]" ]]; then
      maybe_match_rule
      if [[ -n "$matched_theme" ]]; then
        printf '%s\n' "$matched_theme"
        return 0
      fi
      current_path_prefix=""
      current_theme=""
      continue
    fi

    if [[ "$trimmed" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*\"(.*)\"[[:space:]]*$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"

      case "$key" in
        default_theme)
          default_theme="$value"
          ;;
        path_prefix)
          current_path_prefix="$(normalize_path "$value")"
          ;;
        theme)
          current_theme="$value"
          ;;
      esac
    fi
  done <"$CONFIG_FILE"

  maybe_match_rule

  if [[ -n "$matched_theme" ]]; then
    printf '%s\n' "$matched_theme"
    return 0
  fi

  if [[ -n "$default_theme" ]]; then
    printf '%s\n' "$default_theme"
    return 0
  fi

  echo "default_theme is not set in $CONFIG_FILE" >&2
  return 1
}

reload_ghostty() {
  [[ "${TERM_PROGRAM:-}" == "ghostty" ]] || return 0
  command -v osascript >/dev/null 2>&1 || return 0

  osascript <<'APPLESCRIPT' >/dev/null 2>&1 || true
tell application "Ghostty" to activate
tell application "System Events"
  keystroke "r" using command down
end tell
APPLESCRIPT
}

resolve_cmd() {
  local dir="${1:-$PWD}"
  load_theme_for_dir "$dir"
}

apply_cmd() {
  local dir="${1:-$PWD}"
  local theme
  theme="$(load_theme_for_dir "$dir")"

  mkdir -p "$(dirname "$OVERRIDE_FILE")" "$(dirname "$CACHE_FILE")"

  local current_theme=""
  if [[ -f "$CACHE_FILE" ]]; then
    current_theme="$(<"$CACHE_FILE")"
  fi

  local tmp_file
  tmp_file="$(mktemp "${TMPDIR:-/tmp}/ghostty-theme-auto.XXXXXX")"
  printf 'theme = "%s"\n' "$theme" >"$tmp_file"

  if ! cmp -s "$tmp_file" "$OVERRIDE_FILE" 2>/dev/null; then
    mv "$tmp_file" "$OVERRIDE_FILE"
    printf '%s\n' "$theme" >"$CACHE_FILE"
    reload_ghostty
  else
    rm -f "$tmp_file"
    if [[ "$current_theme" != "$theme" ]]; then
      printf '%s\n' "$theme" >"$CACHE_FILE"
    fi
  fi
}

usage() {
  cat <<'EOF'
Usage:
  ghostty-theme-context resolve [DIR]
  ghostty-theme-context apply [DIR]

Rules use `path_prefix`, which matches `DIR` when it is the configured
directory itself or any subdirectory below it.
EOF
}

main() {
  local command="${1:-}"

  case "$command" in
    resolve)
      shift
      resolve_cmd "${1:-$PWD}"
      ;;
    apply)
      shift
      apply_cmd "${1:-$PWD}"
      ;;
    *)
      usage >&2
      return 1
      ;;
  esac
}

main "$@"
